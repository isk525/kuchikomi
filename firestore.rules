rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validReview() {
      return request.resource.data.keys().hasOnly([
          'type', 'title', 'rating', 'tags', 'note',
          'displayName', 'userId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.type in ['ramen', 'movie']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 12
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.userId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && validReview();
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && validReview();
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /ramenMasters/{masterId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'reviewCount', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.reviewCount == 1
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.reviewCount == resource.data.reviewCount + 1;
      allow delete: if false;
    }
  }
}
