rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { function signedIn(){return request.auth!=null;} match /reviews/{id}{ allow read:if signedIn(); allow create:if signedIn()&&request.resource.data.userId==request.auth.uid&&request.resource.data.rating is number&&request.resource.data.rating>=0.5&&request.resource.data.rating<=5; allow update:if signedIn()&&resource.data.userId==request.auth.uid&&request.resource.data.userId==request.auth.uid&&request.resource.data.rating is number&&request.resource.data.rating>=0.5&&request.resource.data.rating<=5; allow delete:if signedIn()&&resource.data.userId==request.auth.uid;} match /users/{uid}{allow read:if signedIn();allow create,update:if signedIn()&&request.auth.uid==uid;} match /ramenMasters/{id}{allow read,create,update:if signedIn();allow delete:if false;} } }
